{
  "name": "@notrealstudio/nr-chat",
  "version": "0.5.0",
  "description": "Atomic %role + JSON5 chat format: parser, canonical emitter, byte-exact in-place editing. Runs in Node, browsers, GAS and userscripts.",
  "keywords": [
    "chat",
    "chat-format",
    "json5",
    "llm",
    "transcript",
    "conversation",
    "parser",
    "serializer",
    "append-only",
    "streaming"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/nr-chat.global.js"
  },
  "unpkg": "./dist/nr-chat.global.js",
  "jsdelivr": "./dist/nr-chat.global.js",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && node build/global.mjs",
    "test": "vitest run",
    "pretest": "npm run build",
    "prepublishOnly": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.peerDependencies}).filter(([,v])=>String(v).startsWith('file:'));if(bad.length){console.error('publish blocked: file: deps '+bad.map(([k])=>k).join(', '));process.exit(1)}\""
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Julian Garrett",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Not-Real-Studio/nr-chat.git"
  },
  "homepage": "https://github.com/Not-Real-Studio/nr-chat#readme",
  "bugs": {
    "url": "https://github.com/Not-Real-Studio/nr-chat/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@notrealstudio/nr-json5": "^0.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
